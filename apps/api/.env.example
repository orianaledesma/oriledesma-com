# Copiá este archivo a .env. Todo es opcional en desarrollo:
# sin claves, la API usa adapters en memoria y loguea los avisos.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=10

MAILERLITE_API_KEY=
MAILERLITE_GROUP_NEWSLETTER=
MAILERLITE_GROUP_GUIDE=

RESEND_API_KEY=
NOTIFY_FROM="OriLedesma.com <web@oriledesma.com>"
NOTIFY_TO=oriledesmaia@gmail.com

COURSE_SEATS_TOTAL=20
COURSE_SEATS_SOLD=0
