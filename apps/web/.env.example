# ── Modo de los formularios ─────────────────────────────────────────────
# Con VITE_API_URL, los formularios van a la API propia (apps/api).
# Sin ella, van directo a MailerLite (MVP sin back): hacen falta las VITE_MAILERLITE_*.
VITE_API_URL=

# IDs del código de inserción de cada formulario de MailerLite:
#   https://assets.mailerlite.com/jsonp/<ACCOUNT_ID>/forms/<FORM_ID>/subscribe
VITE_MAILERLITE_ACCOUNT_ID=
VITE_MAILERLITE_FORM_NEWSLETTER=
VITE_MAILERLITE_FORM_GUIDE=
VITE_MAILERLITE_FORM_IMPLEMENTATION=
VITE_MAILERLITE_FORM_LIVES=

# ── Analytics ───────────────────────────────────────────────────────────
# ID de GA4 (G-XXXXXXX). Vacío = analytics apagado y sin banner de cookies.
VITE_GA_MEASUREMENT_ID=
